# ==============================================================================
# NEC Campus Copilot AI — Environment Configuration Template
# Narasaraopeta Engineering College (Autonomous)
# ==============================================================================

# Groq Cloud API Credentials (obtain from https://console.groq.com)
GROQ_API_KEY=your_actual_groq_api_key_here

# Supported Groq Models:
# - openai/gpt-oss-20b (Recommended: Ultra-fast tool calling, ~2-3s response time)
# - llama-3.3-70b-versatile (Production 70B parameter model)
# - mixtral-8x7b-32768
GROQ_MODEL=openai/gpt-oss-20b

# Safety & Agent Configuration (Maximum tool calling loops before fallback)
MAX_ITERATIONS=5

# Server & CORS Configuration
FRONTEND_ORIGIN=http://localhost:5173
